# ---------------------------------------------------------------------------
# Chairside environment variables. Copy to .env.local and fill in.
# Only the Supabase values are required to run locally; everything else has
# a safe fallback (typed notes, blank cards, template texts, SMS test mode,
# billing off).
# ---------------------------------------------------------------------------

# Public URL of the app (no trailing slash). Used for Twilio/Stripe callbacks and invite links.
APP_URL=http://localhost:3000

# --- Supabase (required) ---------------------------------------------------
# Local: printed by `supabase start`. Hosted: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the cron sender and webhooks. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Speech to text --------------------------------------------------------
# whisper (default) or deepgram
STT_PROVIDER=whisper
OPENAI_API_KEY=
# Optional: whisper-1 (default), gpt-4o-transcribe, gpt-4o-mini-transcribe
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Only if STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# --- Anthropic (card extraction + follow-up drafting) -----------------------
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# --- Twilio SMS ------------------------------------------------------------
# Leave blank (or set SMS_TEST_MODE=true) to log texts instead of sending them.
SMS_TEST_MODE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Optional: the exact inbound webhook URL configured in Twilio, if it differs from APP_URL/api/twilio/inbound
TWILIO_WEBHOOK_URL=

# --- Scheduled sending -----------------------------------------------------
# Any long random string. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# --- Stripe (billing, last phase) ------------------------------------------
# Leave STRIPE_SECRET_KEY blank to switch billing off (everything unlocked).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring monthly prices: Solo $7.99, Salon $49 (per location, quantity-based)
STRIPE_PRICE_SOLO=
STRIPE_PRICE_SALON=
